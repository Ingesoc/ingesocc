{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/ingesocc-web/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/cloudinary/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
